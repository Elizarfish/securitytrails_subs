<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Админ: Бронирования</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
<div class="container py-4">
  <h1 class="mb-4">Бронирования на дату</h1>
  <form class="row g-3 mb-3" method="get">
    <div class="col-md-4">
      <label class="form-label">Дата</label>
      <input type="date" class="form-control" name="date" value="<%= date %>">
    </div>
    <div class="col-md-2 d-flex align-items-end">
      <button class="btn btn-secondary w-100">Обновить</button>
    </div>
  </form>

  <div class="card">
    <div class="card-header">Список броней</div>
    <div class="table-responsive">
      <table class="table table-striped mb-0">
        <thead>
          <tr>
            <th>ID</th>
            <th>Студия</th>
            <th>Имя</th>
            <th>Телефон</th>
            <th>Дата</th>
            <th>Начало</th>
            <th>Конец</th>
            <th>Создано</th>
          </tr>
        </thead>
        <tbody>
        <% if (bookings.length === 0) { %>
          <tr><td colspan="8" class="text-center">Нет броней</td></tr>
        <% } else { %>
          <% bookings.forEach(b => { %>
            <tr>
              <td><%= b.id %></td>
              <td><%= b.studio_name %></td>
              <td><%= b.customer_name %></td>
              <td><%= b.customer_phone %></td>
              <td><%= b.date %></td>
              <td><%= b.start_time %></td>
              <td><%= b.end_time %></td>
              <td><%= b.created_at %></td>
            </tr>
          <% }) %>
        <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
</body>
</html>
