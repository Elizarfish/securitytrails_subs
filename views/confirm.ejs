<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Бронирование подтверждено</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
<div class="container py-4">
  <h1 class="mb-3">Бронирование подтверждено</h1>
  <p>Спасибо, <strong><%= booking.customer_name %></strong>!</p>
  <p>
    Студия: <strong><%= studio.name %></strong><br>
    Дата: <strong><%= booking.date %></strong><br>
    Время: <strong><%= booking.start_time %>–<%= booking.end_time %></strong>
  </p>
  <a class="btn btn-primary" href="/">На главную</a>
  <a class="btn btn-outline-secondary" href="/admin?date=<%= booking.date %>">Посмотреть все брони за день</a>
</div>
</body>
</html>
