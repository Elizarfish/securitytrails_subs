<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= studio.name %> — расписание</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
<div class="container py-4">
  <a href="/" class="btn btn-link">← Назад</a>
  <h1 class="mb-3"><%= studio.name %></h1>
  <p class="text-muted"><%= studio.description %>. Цена: <strong><%= studio.hourly_price %>₽/час</strong></p>

  <form class="row g-3 mb-4" method="get">
    <div class="col-md-4">
      <label class="form-label">Дата</label>
      <input type="date" class="form-control" name="date" value="<%= date %>">
    </div>
    <div class="col-md-2 d-flex align-items-end">
      <button class="btn btn-secondary w-100">Обновить</button>
    </div>
  </form>

  <div class="card">
    <div class="card-header">Забронированные интервалы</div>
    <ul class="list-group list-group-flush">
      <% if (bookings.length === 0) { %>
        <li class="list-group-item">На выбранную дату нет бронирований</li>
      <% } else { %>
        <% bookings.forEach(b => { %>
          <li class="list-group-item">
            <strong><%= b.start_time %>–<%= b.end_time %></strong>
            — <%= b.customer_name %> (<%= b.customer_phone %>)
          </li>
        <% }) %>
      <% } %>
    </ul>
  </div>

  <h3 class="mt-4">Забронировать время</h3>
  <form class="row g-3" method="post" action="/bookings">
    <input type="hidden" name="studio_id" value="<%= studio.id %>">
    <div class="col-md-4">
      <label class="form-label">Дата</label>
      <input type="date" class="form-control" name="date" value="<%= date %>" required>
    </div>
    <div class="col-md-3">
      <label class="form-label">Начало</label>
      <input type="time" class="form-control" name="start_time" required>
    </div>
    <div class="col-md-3">
      <label class="form-label">Конец</label>
      <input type="time" class="form-control" name="end_time" required>
    </div>
    <div class="col-md-6">
      <label class="form-label">Имя</label>
      <input type="text" class="form-control" name="customer_name" placeholder="Иван Иванов" required>
    </div>
    <div class="col-md-6">
      <label class="form-label">Телефон</label>
      <input type="tel" class="form-control" name="customer_phone" placeholder="+7 900 000-00-00" required>
    </div>
    <div class="col-12">
      <button class="btn btn-primary">Забронировать</button>
    </div>
  </form>
</div>
</body>
</html>
