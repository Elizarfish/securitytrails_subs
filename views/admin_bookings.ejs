<% const pageTitle = 'Все бронирования'; %>
<%- include('partials/page', { title: pageTitle, body: `
  <table class=\"table\">
    <thead>
      <tr>
        <th>ID</th>
        <th>Студия</th>
        <th>Клиент</th>
        <th>Email</th>
        <th>Начало</th>
        <th>Конец</th>
        <th>Статус</th>
      </tr>
    </thead>
    <tbody>
      ${bookings.map(b => `
        <tr>
          <td>${b.id}</td>
          <td>${b.studio_name}</td>
          <td>${b.customer_name}</td>
          <td>${b.customer_email}</td>
          <td>${dayjs(b.start_time).format('DD.MM.YYYY HH:mm')}</td>
          <td>${dayjs(b.end_time).format('HH:mm')}</td>
          <td>${b.status}</td>
        </tr>
      `).join('')}
    </tbody>
  </table>
` }) %>
