<% const pageTitle = 'Выберите студию'; %>
<%- include('partials/page', { title: pageTitle, body: `
  <div class=\"studios\">
    ${studios.map(s => `
      <a class=\"card\" href=\"/studio/${s.id}\"> 
        <h3>${s.name}</h3>
        <p>${s.description || ''}</p>
        <div class=\"price\">${formatMoney(s.hourly_rate_cents)} / час</div>
      </a>
    `).join('')}
  </div>
` }) %>
