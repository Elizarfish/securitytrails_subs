<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Бронирование фотостудии</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
<div class="container py-4">
  <h1 class="mb-4">Выберите студию и дату</h1>
  <form class="row g-3" method="get" action="/studio/1" id="studioForm">
    <div class="col-md-4">
      <label class="form-label">Студия</label>
      <select class="form-select" name="studio" id="studioSelect">
        <% studios.forEach(s => { %>
          <option value="<%= s.id %>"><%= s.name %> — <%= s.hourly_price %>₽/час</option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-4">
      <label class="form-label">Дата</label>
      <input type="date" class="form-control" name="date" value="<%= selectedDate %>">
    </div>
    <div class="col-md-4 d-flex align-items-end">
      <button class="btn btn-primary w-100" type="submit">Показать расписание</button>
    </div>
  </form>
</div>
<script>
  const form = document.getElementById('studioForm');
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const studioId = document.getElementById('studioSelect').value;
    const params = new URLSearchParams(new FormData(form));
    const date = params.get('date');
    window.location.href = `/studio/${studioId}?date=${encodeURIComponent(date)}`;
  });
</script>
</body>
</html>
