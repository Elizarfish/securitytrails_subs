{
  "name": "photo-studio-booking",
  "version": "1.0.0",
  "description": "Приложение для бронирования фотостудии",
  "main": "server/index.js",
  "scripts": {
    "start": "SERVER_PORT=3001 node server/index.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "SERVER_PORT=3001 nodemon server/index.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "install-all": "npm install && cd client && npm install"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "sqlite3": "^5.1.6",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "express-validator": "^7.0.1",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2"
  },
  "keywords": ["photo", "studio", "booking", "reservation"],
  "author": "Your Name",
  "license": "MIT"
}